{
  "uid": "mobiad-overview",
  "title": "MobiAd – Overview",
  "tags": ["mobiad"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    { "id": 1, "type": "stat", "title": "Ad requests / s", "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(rate(mobiad_ad_requests_total[5m]))", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "reqps" } } },
    { "id": 2, "type": "stat", "title": "Fill rate", "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [{ "expr": "sum(rate(mobiad_ad_requests_total{filled=\"true\"}[5m])) / clamp_min(sum(rate(mobiad_ad_requests_total[5m])), 0.001)", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "percentunit" } } },
    { "id": 3, "type": "stat", "title": "p99 ad latency", "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [{ "expr": "histogram_quantile(0.99, sum by (le) (rate(mobiad_http_duration_seconds_bucket{route=\"/v1/ad\"}[5m])))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.05 }, { "color": "red", "value": 0.1 }] } } } },
    { "id": 4, "type": "stat", "title": "5xx ratio", "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [{ "expr": "(sum(rate(mobiad_http_requests_total{status=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(mobiad_http_requests_total[5m])), 1)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.02 }] } } } },
    { "id": 5, "type": "stat", "title": "Billing events dropped (1h)", "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [{ "expr": "sum(increase(mobiad_ledger_dropped_total[1h]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } } },
    { "id": 6, "type": "stat", "title": "Redis degraded", "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "targets": [{ "expr": "max(mobiad_redis_degraded)", "refId": "A" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "OK" }, "1": { "text": "DEGRADED" } } }], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] } } } },

    { "id": 10, "type": "timeseries", "title": "Ad requests by outcome", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "sum by (filled) (rate(mobiad_ad_requests_total[5m]))", "legendFormat": "filled={{filled}}", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "reqps" } } },
    { "id": 11, "type": "timeseries", "title": "Request latency (ad requests)", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(mobiad_http_duration_seconds_bucket{route=\"/v1/ad\"}[5m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(mobiad_http_duration_seconds_bucket{route=\"/v1/ad\"}[5m])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(mobiad_http_duration_seconds_bucket{route=\"/v1/ad\"}[5m])))", "legendFormat": "p99", "refId": "C" }],
      "fieldConfig": { "defaults": { "unit": "s" } } },
    { "id": 12, "type": "timeseries", "title": "HTTP requests by status class", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [{ "expr": "sum by (status) (rate(mobiad_http_requests_total[5m]))", "legendFormat": "{{status}}", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "reqps" } } },
    { "id": 13, "type": "timeseries", "title": "Tracking events (impressions / clicks / installs)", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [{ "expr": "sum by (kind, result) (rate(mobiad_tracking_total[5m]))", "legendFormat": "{{kind}} {{result}}", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "ops" } } },
    { "id": 14, "type": "timeseries", "title": "Invalid clicks by reason", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [{ "expr": "sum by (reason) (rate(mobiad_invalid_clicks_total[5m]))", "legendFormat": "{{reason}}", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "ops" } } },
    { "id": 15, "type": "timeseries", "title": "Frequency-cap skips", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [{ "expr": "rate(mobiad_freqcap_skips_total[5m])", "legendFormat": "skips/s", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "ops" } } },

    { "id": 20, "type": "row", "title": "Billing pipeline", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 28 }, "panels": [] },
    { "id": 21, "type": "timeseries", "title": "Ledger queue (events waiting for Postgres)", "gridPos": { "h": 8, "w": 8, "x": 0, "y": 29 },
      "targets": [{ "expr": "max(mobiad_ledger_queue)", "legendFormat": "queue", "refId": "A" }] },
    { "id": 22, "type": "timeseries", "title": "Ledger writes / failures", "gridPos": { "h": 8, "w": 8, "x": 8, "y": 29 },
      "targets": [
        { "expr": "sum(rate(mobiad_ledger_written_total[5m]))", "legendFormat": "written/s", "refId": "A" },
        { "expr": "sum(rate(mobiad_ledger_failed_total[5m]))", "legendFormat": "failed/s", "refId": "B" }] },
    { "id": 23, "type": "timeseries", "title": "Kafka: produced / consumed / fallback / dead-letter", "gridPos": { "h": 8, "w": 8, "x": 16, "y": 29 },
      "targets": [
        { "expr": "sum(rate(mobiad_kafka_produced_total[5m]))", "legendFormat": "produced/s", "refId": "A" },
        { "expr": "sum(rate(mobiad_kafka_consumed_total[5m]))", "legendFormat": "consumed/s", "refId": "B" },
        { "expr": "sum(rate(mobiad_kafka_fallback_total[5m]))", "legendFormat": "fallback/s", "refId": "C" },
        { "expr": "sum(rate(mobiad_kafka_dlq_total[5m]))", "legendFormat": "dead-letter/s", "refId": "D" }] },

    { "id": 30, "type": "row", "title": "Operations & capacity", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 37 }, "panels": [] },
    { "id": 31, "type": "stat", "title": "Campaigns awaiting review", "gridPos": { "h": 4, "w": 6, "x": 0, "y": 38 },
      "targets": [{ "expr": "max(mobiad_campaigns_pending_review)", "refId": "A" }] },
    { "id": 32, "type": "stat", "title": "Flagged apps", "gridPos": { "h": 4, "w": 6, "x": 6, "y": 38 },
      "targets": [{ "expr": "max(mobiad_apps_flagged)", "refId": "A" }] },
    { "id": 33, "type": "stat", "title": "Payout requests", "gridPos": { "h": 4, "w": 6, "x": 12, "y": 38 },
      "targets": [{ "expr": "max(mobiad_payouts_pending)", "refId": "A" }] },
    { "id": 34, "type": "stat", "title": "Campaign counter failures (1h)", "gridPos": { "h": 4, "w": 6, "x": 18, "y": 38 },
      "targets": [{ "expr": "sum(increase(mobiad_counter_update_failures_total[1h]))", "refId": "A" }] },
    { "id": 35, "type": "timeseries", "title": "Pod memory (RSS)", "gridPos": { "h": 8, "w": 8, "x": 0, "y": 42 },
      "targets": [{ "expr": "mobiad_process_resident_memory_bytes", "legendFormat": "{{instance}}", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "bytes" } } },
    { "id": 36, "type": "timeseries", "title": "Event-loop lag p99", "gridPos": { "h": 8, "w": 8, "x": 8, "y": 42 },
      "targets": [{ "expr": "mobiad_eventloop_lag_p99_seconds", "legendFormat": "{{instance}}", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "s" } } },
    { "id": 37, "type": "timeseries", "title": "Postgres pool (total / idle / waiting)", "gridPos": { "h": 8, "w": 8, "x": 16, "y": 42 },
      "targets": [
        { "expr": "max(mobiad_db_pool_total)", "legendFormat": "total", "refId": "A" },
        { "expr": "max(mobiad_db_pool_idle)", "legendFormat": "idle", "refId": "B" },
        { "expr": "max(mobiad_db_pool_waiting)", "legendFormat": "waiting", "refId": "C" }] }
  ]
}
